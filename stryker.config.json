{
  "$schema": "./node_modules/@stryker-mutator/core/schema/stryker-schema.json",
  "_comment": "Task 3.1: Stryker mutation testing 配置。使用 vitest-runner，聚焦核心纯逻辑模块。",
  "packageManager": "npm",
  "reporters": ["html", "clear-text", "progress"],
  "testRunner": "vitest",
  "vitest": {
    "configFile": "vitest.config.stryker.ts"
  },
  "coverageAnalysis": "perTest",
  "mutate": [
    "src/infrastructure/ai-providers/model-capabilities-utils.ts"
  ],
  "disableTypeChecks": "src/**/*.ts",
  "thresholds": {
    "high": 80,
    "low": 60,
    "break": 50
  },
  "timeoutMS": 90000,
  "concurrency": 2,
  "ignoreStatic": true
}
